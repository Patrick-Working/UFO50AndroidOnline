# For the full build (build.sh): copy to local.env and uncomment what it can't find by itself.
# Windows paths (C:\...) and Git Bash paths (/c/...) both work.
# (The quick build takes -GamePath instead: build.bat -GamePath "D:\...\UFO 50")

# ANDROID_SDK="C:\Users\you\AppData\Local\Android\Sdk"
# JAVA_HOME="C:\Program Files\Eclipse Adoptium\jdk-21.0.5.11-hotspot"
# GM_RUNTIMES="C:\ProgramData\GameMakerStudio2\Cache\runtimes"
# GM_USER_DIR="C:\Users\you\AppData\Roaming\GameMakerStudio2\yourname_12345"

# For development:
# MODDED_DIR="..."   an already-modded copy of the game (skips the Mod Loader step)
# OKPLAY_DIR="..."   a local okplay checkout instead of downloading oknative from GitHub
